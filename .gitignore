# Build outputs
dist/
target/
src-tauri/target/
# Tauri build script regenerates these from tauri.conf.json on every
# build. Per-platform output (macOS-schema.json etc.) makes them noisy
# in git and there is no value in committing them.
src-tauri/gen/

# Dependencies
node_modules/
.pnpm-store/
.venv/
.cargo-home/
.cache/
.local/

# OS
.DS_Store
Thumbs.db

# Editor / IDE
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# Env / local config
.env
.env.local
.env.*.local
.claude/settings.local.json

# Logs
*.log
npm-debug.log*

# Plume runtime
.plume/
plume-data/
plume-logs/
plume-models/
.eslintcache

# Benchmark harness (D129): local artifacts only — raw result JSONL
# is committed deliberately and reviewed, never from this directory.
benchmark-artifacts/
