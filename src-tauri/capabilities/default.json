{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Trusted capability for the local main webview only. Every Plume command is explicit so a separately labelled remote-content webview receives no application authority. `core:event:default` plus app listener register/remove enables the event listening Plume uses for streamed chat and drag/drop.",
  "webviews": ["main"],
  "permissions": [
    "core:event:default",
    "core:app:allow-register-listener",
    "core:app:allow-remove-listener",
    "allow-ping",
    "allow-browser-sandbox-open",
    "allow-browser-sandbox-close",
    "allow-browser-sandbox-state",
    "allow-project-open",
    "allow-project-refresh",
    "allow-project-trust",
    "allow-project-trust-state",
    "allow-fs-list",
    "allow-fs-read",
    "allow-providers-list",
    "allow-providers-health",
    "allow-providers-local-models",
    "allow-providers-local-model-details",
    "allow-providers-model-details",
    "allow-providers-start-server",
    "allow-providers-stop-server",
    "allow-providers-server-diagnostics",
    "allow-system-snapshot",
    "allow-chat-send",
    "allow-chat-cancel",
    "allow-chat-context",
    "allow-patch-validate",
    "allow-patch-apply",
    "allow-patch-revert",
    "allow-memory-index",
    "allow-memory-remember",
    "allow-memory-update",
    "allow-memory-forget",
    "allow-memory-search",
    "allow-memory-distill-preview",
    "allow-memory-distill-apply",
    "allow-memory-distill-log",
    "allow-memory-topics",
    "allow-memory-set-links",
    "allow-session-set-mode",
    "allow-session-set-approval-policy",
    "allow-session-set-allowlist",
    "allow-session-state",
    "allow-sessions-list",
    "allow-sessions-fork",
    "allow-sessions-rollback",
    "allow-sessions-create",
    "allow-sessions-load",
    "allow-sessions-rename",
    "allow-sessions-archive",
    "allow-sessions-delete",
    "allow-sessions-save-transcript",
    "allow-sessions-search",
    "allow-skills-list",
    "allow-skills-load",
    "allow-skills-preview",
    "allow-skills-apply",
    "allow-skills-promote-preview",
    "allow-skills-promotion-context",
    "allow-tools-list",
    "allow-tools-search",
    "allow-agent-dry-run",
    "allow-agent-single-step"
  ]
}
