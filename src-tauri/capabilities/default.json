{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Trusted capability for the local main webview only. Every Plume command is explicit so a separately labelled remote-content webview receives no application authority. `core:event:default` plus app listener register/remove enables the event listening Plume uses for streamed chat and drag/drop.",
